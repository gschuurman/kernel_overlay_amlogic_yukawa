CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_KEYBOARD_GPIO_POLLED=m
CONFIG_KEYBOARD_ADC=m
# pstore_blk/pstore_zone require filp_open which is on the GKI ABI denylist;
# disable the block-device backend (base pstore via RAM/ftrace still works)
CONFIG_PSTORE_BLK=n
CONFIG_PSTORE_ZONE=n
# ALSA loopback: built in (not =m) so the "Loopback" card is always present.
# Backs the native radio audio path — the RTL-SDR HAL writes decoded PCM to the
# loopback playback side, exposed to the audio HAL as DEVICE_IN_FM_TUNER.
# SND_ALOOP lives under the SND_DRIVERS submenu, which gki_defconfig disables
# by default -- must enable it or SND_ALOOP is dropped. (Note for future
# edits: avoid spelling out this file's own CONFIG_ symbol names verbatim in
# nearby comments -- merge_config.sh's `grep -w` symbol matching isn't
# comment-aware and will pick up the literal text, producing a garbled
# "New value" warning during the merge.)
CONFIG_SND_DRIVERS=y
CONFIG_SND_ALOOP=y

# NOTE: DRM_PANFROST, the BCM4359 WiFi/BT stack (CFG80211/BRCMFMAC/MAC80211/
# BT_HCIUART), CRYPTO_DEV_AMLOGIC_GXL, and DMABUF_HEAPS_SYSTEM/CMA used to be
# duplicated here because the 2026-07 GKI rebase silently dropped them from
# amlogic_gki.fragment (that's what caused the post-rebase black-screen boot
# failure). amlogic_gki.fragment has since been restored to match the
# pre-rebase baseline (see backup-pre-gki-6.12.89), so those overrides moved
# back there and were removed from here to avoid drift between two copies of
# the same settings. If a future rebase drops them again, restore from that
# same backup branch rather than re-patching piecemeal.

# NOT actually needed for brcmfmac anymore -- the real fix for that was in
# the kernel source itself: brcmfmac/Makefile and fwvid.c on this fork are
# patched (see backup-pre-gki-6.12.89) to statically link the wcc/cyw/bca
# per-vendor "fwvid" code directly into brcmfmac.ko instead of splitting it
# into a separately-loaded brcmfmac-wcc.ko pulled in via the kernel's
# request_module() at probe time. The GKI rebase silently reverted both
# files to plain upstream behavior (separate module, real request_module()
# call), which is what actually caused tonight's WiFi failure -- not
# anything fixable from Kconfig. Both files have been restored.
#
# Kept anyway as a general-purpose safety net: Android has no /lib/modules,
# so the default CONFIG_MODPROBE_PATH (toolbox's modprobe) fails any
# kernel-triggered request_module() call with -2, and separately,
# gki_defconfig's CONFIG_STATIC_USERMODEHELPER=y with an empty path makes
# the kernel ignore CONFIG_MODPROBE_PATH entirely in favor of this one fixed
# binary for every call_usermodehelper() call. modprobe_vim3 (device tree)
# is a thin wrapper that points modprobe at /vendor_dlkm and /system_dlkm;
# pointing both knobs at it means any *other* driver that ever relies on
# runtime module autoload on this board won't hit the same multi-night dead
# end brcmfmac's did.
CONFIG_MODPROBE_PATH="/system/bin/modprobe_vim3"
CONFIG_STATIC_USERMODEHELPER_PATH="/system/bin/modprobe_vim3"
